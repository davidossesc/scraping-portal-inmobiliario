# Autenticación vía Application Default Credentials (gcloud auth application-default login),
# no se usa un JSON key de service account (bloqueado por política de la organización).

# Id de la Google Sheet destino (de su URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEET_ID=

# Proyecto y dataset de BigQuery
GCP_PROJECT_ID=
BQ_DATASET=portal_inmobiliario

# Solo para uso local: el scope de Sheets es "sensible" y Google bloquea el
# consentimiento directo con el cliente OAuth de gcloud, así que localmente
# se impersona la service account (requiere rol Service Account Token Creator
# sobre ella). En GitHub Actions NO se setea esta variable (corre directo
# como la service account vía Workload Identity Federation).
GCP_IMPERSONATE_SERVICE_ACCOUNT=

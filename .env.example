# Ruta local al JSON de la service account de Google Cloud (Sheets API + BigQuery API habilitadas)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Id de la Google Sheet destino (de su URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEET_ID=

# Proyecto y dataset de BigQuery
GCP_PROJECT_ID=
BQ_DATASET=portal_inmobiliario
